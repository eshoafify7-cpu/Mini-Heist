# .editorconfig
root = true

[*.cs]
# Put braces on the same line (1TBS style)
csharp_space_before_open_brace = method, type, accessor, control_block, anonymous_method, anonymous_type, indexer, operator, property, event, delegate_declaration, local_function, lambda_expression_body
csharp_new_line_before_open_brace = none
# Or, more granularly for specific types:
# csharp_new_line_before_open_brace = types:false
# csharp_new_line_before_open_brace = methods:false
# csharp_new_line_before_open_brace = properties:false
# csharp_new_line_before_open_brace = accessors:false
# csharp_new_line_before_open_brace = control_blocks:false